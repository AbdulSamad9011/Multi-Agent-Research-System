# --- LLM provider keys (only fill in the ones your model strings below need) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Web search ---
TAVILY_API_KEY=

# --- Model overrides (provider:model — anything init_chat_model supports) ---
PLANNER_MODEL=anthropic:claude-sonnet-4-6
RESEARCHER_MODEL=anthropic:claude-sonnet-4-6
SUMMARIZER_MODEL=anthropic:claude-sonnet-4-6
EMBEDDING_MODEL=openai:text-embedding-3-small

# --- Runtime knobs ---
MIN_SUBAGENTS=3
MAX_SUBAGENTS=4
RAG_TOP_K=5
TAVILY_MAX_RESULTS=5
