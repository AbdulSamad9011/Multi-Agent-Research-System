# --- LLM provider keys (only fill in the ones your model strings below need) ---
# Groq key -> powers planner + researcher models.
GROQ_API_KEY=
# Google GenAI key (Gemini) -> powers summarizer + embeddings; also used by
# graphify's community-labeling backend (auto-detected).
GOOGLE_API_KEY=
# HuggingFace key (HF Inference API) -> powers huggingface:* fallback models
# in the researcher/planner rotations. Get it at hf.co/settings/tokens.
HUGGINGFACEHUB_API_TOKEN=

# --- Web search ---
TAVILY_API_KEY=

# --- Model overrides (provider:model — anything init_chat_model supports) ---
PLANNER_MODEL=google_genai:gemini-3.6-flash
PLANNER_MODELS=google_genai:gemini-3.6-flash,google_genai:gemini-3.5-flash,google_genai:gemini-3.5-flash-lite,google_genai:gemini-3.1-flash-lite,google_genai:gemini-3.7-flash,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
RESEARCHER_MODEL=google_genai:gemini-3.6-flash
# Parallel researcher branches rotate across these models to stay under
# Google free-tier per-model quotas; Groq absorbs the load once Gemini is spent.
RESEARCHER_MODELS=google_genai:gemini-3.6-flash,google_genai:gemini-3.5-flash,google_genai:gemini-3.5-flash-lite,google_genai:gemini-3.1-flash-lite,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
SUMMARIZER_MODEL=groq:openai/gpt-oss-120b
# Converts each researcher's free-text notes into the SubAgentFindings schema.
EXTRACTOR_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
EMBEDDING_MODEL=google_genai:gemini-embedding-2

# --- Graphify LLM backend (community naming) ---
# graphify auto-detects Google Gemini from GOOGLE_API_KEY above (priority #1).
# To use Groq as graphify's backend instead, uncomment and point these at Groq's
# OpenAI-compatible endpoint (requires: uv tool install "graphifyy[openai]"):
# OPENAI_API_KEY=<your groq key>
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=qwen/qwen3.6-27b

# --- Runtime knobs ---
MIN_SUBAGENTS=3
MAX_SUBAGENTS=3
RAG_TOP_K=5
TAVILY_MAX_RESULTS=5